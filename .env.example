# Wajib: dari https://my.telegram.org/apps
API_ID=12345678
API_HASH=isi_api_hash

# Wajib: hasil npm run session. JANGAN upload ke GitHub.
TELEGRAM_SESSION=isi_string_session

# Grup sumber Pasukan Kodok. Bisa ID seperti -1001234567890 atau username grup publik.
SOURCE_CHAT=-1001234567890

# Bot tujuan tanpa @
TARGET_BOT_USERNAME=toolsfixredupgradeGAARZ_BOT

# Format yang dikirim persis dua baris:
TARGET_COMMAND=/fix

# Saat bot Gaarz menolak akses dan meminta cek ulang join channel,
# automation akan menekan tombol "Sudah Join Semua — Cek Ulang" secara otomatis.
AUTO_CLICK_JOIN_CHECK=true
ACCESS_DENIED_PATTERNS=AKSES DITOLAK|WAJIB JOIN|JOIN 3 CHANNEL DULU
JOIN_CHECK_BUTTON_PATTERNS=SUDAH JOIN SEMUA|CEK ULANG
JOIN_CHECK_DELAY_MS=2000
JOIN_CHECK_MAX_ATTEMPTS=3

# Report dianggap selesai jika memuat salah satu pola ini.
SUCCESS_PATTERNS=FIX MERAH SELESAI|EMAIL DIBALAS — SUKSES|EMAIL DIBALAS - SUKSES|BANDING BERHASIL TERKIRIM|BANDING BERHASIL DIKIRIM

# Report gagal opsional.
FAILURE_PATTERNS=GAGAL|TIDAK BERHASIL|INVALID|NOMOR TIDAK VALID

# Balasan ke pesan asli di grup sumber.
SUCCESS_REPLY=✅ Nomor {number} sudah beres ditinjau.
FAILURE_REPLY=❌ Nomor {number} belum berhasil diproses. Silakan cek kembali atau hubungi admin.
TIMEOUT_REPLY=⏳ Nomor {number} belum mendapatkan report selesai. Admin perlu cek bot Gaarz.

# Antrean dikirim satu per satu agar report tidak tertukar.
SEND_DELAY_MS=3000
JOB_TIMEOUT_MINUTES=30
DUPLICATE_WINDOW_HOURS=24

# true = report sukses tanpa nomor tetap dianggap milik job aktif.
# Lebih aman dibiarkan false jika report Gaarz selalu menampilkan nomor.
ALLOW_SUCCESS_WITHOUT_NUMBER=false

# Mode pesan sumber:
# number_only = hanya proses pesan yang isinya satu nomor (paling aman)
# any = proses nomor yang muncul di dalam teks apa pun
SOURCE_MESSAGE_MODE=number_only

# true = kirim pemberitahuan saat nomor duplikat.
NOTIFY_DUPLICATE=true

# Penyimpanan lokal. Pada Render gunakan /var/data/state.json jika memasang Persistent Disk.
STATE_FILE=./state.json

# Server Render
PORT=3000

# Otomatis menangani pesan “AKSES DITOLAK / wajib join” dari bot target
AUTO_HANDLE_JOIN_GATE=true
JOIN_GATE_DELAY_MS=4000
JOIN_GATE_MAX_ATTEMPTS=3
JOIN_GATE_PATTERNS=AKSES DITOLAK|WAJIB JOIN|JOIN CHANNEL DULU|HARUS JOIN
JOIN_CHECK_BUTTON_PATTERNS=SUDAH JOIN SEMUA|CEK ULANG|CHECK AGAIN|VERIFIKASI

# Setelah tombol cek ulang berhasil dan bot meminta /start
AUTO_START_AFTER_VERIFY=true
VERIFY_SUCCESS_PATTERNS=VERIFIKASI BERHASIL|KETIK /START UNTUK MULAI
VERIFY_START_DELAY_MS=1500
RETRY_FIX_AFTER_VERIFY=true
RETRY_FIX_DELAY_MS=2500
VERIFY_RETRY_MAX=2
